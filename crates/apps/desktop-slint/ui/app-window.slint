import { Button, ComboBox, HorizontalBox, LineEdit, TextEdit, VerticalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "LLM App";
    width: 1080px;
    height: 900px;

    in-out property <int> model-product-index: 0;
    in-out property <string> repository;
    in-out property <string> revision;
    in-out property <string> gguf-path;
    in-out property <string> message-input;
    in property <string> selected-model-summary: "No product selected.";
    in property <string> resolved-model-summary: "Not resolved.";
    in property <string> loaded-model-summary: "Not loaded.";
    in property <string> composer-mode: "No model loaded";
    in property <string> composer-guidance: "Load a model to enable generation.";
    in property <string> composer-input-label: "Message";
    in property <string> composer-submit-label: "Send";
    in property <string> status-text: "Ready";
    in property <string> terminal-text: "No response has completed.";
    in property <string> prompt-token-count: "0";
    in property <string> generated-token-count: "0";
    in property <bool> busy: false;
    in property <bool> can-edit-selection: true;
    in property <bool> can-resolve: true;
    in property <bool> can-load: false;
    in property <bool> can-edit-message: false;
    in property <bool> can-submit-message: false;
    in property <bool> can-regenerate: false;
    in property <bool> can-clear-conversation: true;
    in property <bool> can-cancel: false;
    in property <bool> can-unload: false;

    callback resolve-model();
    callback load-model();
    callback unload-model();
    callback submit-message();
    callback regenerate-response();
    callback cancel-generation();
    callback clear-conversation();
    callback append-generated-text(string);
    callback replace-transcript(string);

    append-generated-text(fragment) => {
        // Selection remains owned by this TextEdit. Preserve explicit scroll state per frame batch.
        let saved-viewport-x = transcript-editor.viewport-x;
        let saved-viewport-y = transcript-editor.viewport-y;
        transcript-editor.text += fragment;
        transcript-editor.viewport-x = saved-viewport-x;
        transcript-editor.viewport-y = saved-viewport-y;
    }

    replace-transcript(transcript) => {
        let saved-viewport-x = transcript-editor.viewport-x;
        let saved-viewport-y = transcript-editor.viewport-y;
        transcript-editor.text = transcript;
        transcript-editor.viewport-x = saved-viewport-x;
        transcript-editor.viewport-y = saved-viewport-y;
        transcript-editor.clear-selection();
    }

    VerticalBox {
        padding: 20px;
        spacing: 9px;

        HorizontalBox {
            Text {
                text: "Local model runner";
                font-size: 26px;
                font-weight: 700;
                horizontal-stretch: 1;
            }
            Text {
                text: "Mode: " + root.composer-mode;
                color: #356859;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.composer-guidance;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: 12px;
            Text { text: "Product"; width: 100px; vertical-alignment: center; }
            ComboBox {
                model: [
                    "Candle + Hugging Face Hub + Safetensors",
                    "llama.cpp + local file + GGUF",
                ];
                current-index <=> root.model-product-index;
                enabled: root.can-edit-selection;
            }
        }

        if root.model-product-index == 0 : HorizontalBox {
            spacing: 12px;
            Text { text: "Repository"; width: 100px; vertical-alignment: center; }
            LineEdit {
                text <=> root.repository;
                enabled: root.can-edit-selection;
            }
            Text { text: "Revision"; width: 70px; vertical-alignment: center; }
            LineEdit {
                text <=> root.revision;
                enabled: root.can-edit-selection;
                width: 190px;
            }
        }

        if root.model-product-index == 1 : HorizontalBox {
            spacing: 12px;
            Text { text: "GGUF path"; width: 100px; vertical-alignment: center; }
            LineEdit {
                text <=> root.gguf-path;
                enabled: root.can-edit-selection;
                placeholder-text: "/path/to/model.gguf";
            }
        }

        Text {
            text: "Selected — " + root.selected-model-summary;
            wrap: word-wrap;
        }
        Text {
            text: "Resolved — " + root.resolved-model-summary;
            wrap: word-wrap;
        }
        Text {
            text: "Loaded — " + root.loaded-model-summary;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: 10px;
            Button {
                text: "Resolve & cache";
                enabled: root.can-resolve;
                clicked => { root.resolve-model(); }
            }
            Button {
                text: "Load CPU model";
                enabled: root.can-load;
                clicked => { root.load-model(); }
            }
            Button {
                text: "Unload";
                enabled: root.can-unload;
                clicked => { root.unload-model(); }
            }
        }

        Rectangle { height: 1px; background: #d0d0d0; }

        Text {
            text: "Transcript • " + root.composer-mode;
            font-weight: 700;
        }
        transcript-editor := TextEdit {
            text: "";
            read-only: true;
            wrap: word-wrap;
            height: 280px;
        }

        Text {
            text: root.composer-input-label;
            font-weight: 700;
        }
        TextEdit {
            text <=> root.message-input;
            enabled: root.can-edit-message;
            height: 90px;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: 10px;
            Button {
                text: root.composer-submit-label;
                enabled: root.can-submit-message;
                clicked => { root.submit-message(); }
            }
            Button {
                text: "Regenerate";
                enabled: root.can-regenerate;
                clicked => { root.regenerate-response(); }
            }
            Button {
                text: "Cancel";
                enabled: root.can-cancel;
                clicked => { root.cancel-generation(); }
            }
            Button {
                text: "Clear transcript";
                enabled: root.can-clear-conversation;
                clicked => { root.clear-conversation(); }
            }
            Text {
                text: "Default sampling • maximum 128 new tokens";
                color: #666666;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: "Context " + root.prompt-token-count + " • Generated " + root.generated-token-count;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 1px; background: #d0d0d0; }

        Text {
            text: "Status: " + root.status-text;
            wrap: word-wrap;
        }
        Text {
            text: "Response: " + root.terminal-text;
            wrap: word-wrap;
            color: #555555;
        }
    }
}
