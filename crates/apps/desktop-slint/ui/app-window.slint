import { Button, HorizontalBox, LineEdit, TextEdit, VerticalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "LLM App";
    width: 960px;
    height: 760px;

    in-out property <string> repository;
    in-out property <string> revision;
    in-out property <string> prompt;
    in property <string> status-text: "Ready";
    in property <string> terminal-text: "No generation has completed.";
    in property <string> resolved-commit: "Not resolved";
    in property <string> prompt-token-count: "0";
    in property <string> generated-token-count: "0";
    in property <bool> busy: false;
    in property <bool> can-resolve: true;
    in property <bool> can-load: false;
    in property <bool> can-edit-prompt: false;
    in property <bool> can-generate: false;
    in property <bool> can-cancel: false;
    in property <bool> can-unload: false;

    callback resolve-model();
    callback load-model();
    callback unload-model();
    callback generate();
    callback cancel-generation();
    callback clear-output();
    callback append-generated-output(string);
    callback reset-generated-output();

    append-generated-output(fragment) => {
        // Selection remains owned by this TextEdit instance. Preserve its explicit scroll state.
        let saved-viewport-x = output-editor.viewport-x;
        let saved-viewport-y = output-editor.viewport-y;
        output-editor.text += fragment;
        output-editor.viewport-x = saved-viewport-x;
        output-editor.viewport-y = saved-viewport-y;
    }

    reset-generated-output() => {
        output-editor.text = "";
        output-editor.viewport-x = 0px;
        output-editor.viewport-y = 0px;
        output-editor.clear-selection();
    }

    VerticalBox {
        padding: 20px;
        spacing: 10px;

        HorizontalBox {
            Text {
                text: "Local completion";
                font-size: 26px;
                font-weight: 700;
                horizontal-stretch: 1;
            }
            Text {
                text: "Candle • CPU";
                color: #356859;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Resolve an immutable Hugging Face revision, load it on CPU, then run a direct completion.";
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: 12px;
            Text { text: "Repository"; width: 100px; vertical-alignment: center; }
            LineEdit {
                text <=> root.repository;
                enabled: !root.busy && !root.can-unload;
            }
            Text { text: "Revision"; width: 70px; vertical-alignment: center; }
            LineEdit {
                text <=> root.revision;
                enabled: !root.busy && !root.can-unload;
                width: 180px;
            }
        }

        HorizontalBox {
            spacing: 10px;
            Button {
                text: "Resolve & cache";
                enabled: root.can-resolve;
                clicked => { root.resolve-model(); }
            }
            Button {
                text: "Load CPU model";
                enabled: root.can-load;
                clicked => { root.load-model(); }
            }
            Button {
                text: "Unload";
                enabled: root.can-unload;
                clicked => { root.unload-model(); }
            }
            Text {
                text: "Commit: " + root.resolved-commit;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        Rectangle { height: 1px; background: #d0d0d0; }

        Text {
            text: "Prompt";
            font-weight: 700;
        }
        TextEdit {
            text <=> root.prompt;
            enabled: root.can-edit-prompt;
            height: 130px;
            wrap: word-wrap;
        }

        HorizontalBox {
            spacing: 10px;
            Button {
                text: "Generate";
                enabled: root.can-generate;
                clicked => { root.generate(); }
            }
            Button {
                text: "Cancel";
                enabled: root.can-cancel;
                clicked => { root.cancel-generation(); }
            }
            Button {
                text: "Clear output";
                clicked => { root.clear-output(); }
            }
            Text {
                text: "Default sampling • maximum 128 new tokens";
                color: #666666;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: "Prompt " + root.prompt-token-count + " • Generated " + root.generated-token-count;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Generated output";
            font-weight: 700;
        }
        output-editor := TextEdit {
            text: "";
            read-only: true;
            wrap: word-wrap;
            height: 210px;
        }

        Rectangle { height: 1px; background: #d0d0d0; }

        Text {
            text: "Status: " + root.status-text;
            wrap: word-wrap;
        }
        Text {
            text: "Terminal: " + root.terminal-text;
            wrap: word-wrap;
            color: #555555;
        }
    }
}
