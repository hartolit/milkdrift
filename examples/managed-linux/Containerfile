# Build from the repository root with an exact, reviewed Rust image containing Git and a C linker.
# The approved image binds both the toolchain and this version of the example's initial content.
ARG TOOLCHAIN_IMAGE
FROM ${TOOLCHAIN_IMAGE}
ENV CARGO_HOME=/workspace/home/.cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/workspace/home/bin:/workspace/home/.cargo/bin:/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin
RUN git --version && rustc --version && cargo --version && cc --version
COPY docs/guides/adaptive-method-example.md /usr/share/milkdrift/slotbook.md
RUN printf '%s\n' '#!/bin/sh' 'set -eu' \
    'git --version; rustc --version; cargo --version; cc --version' \
    'mkdir -p /workspace/source /workspace/output /workspace/docs /workspace/home' \
    'if [ ! -e /workspace/docs/slotbook.md ]; then cp /usr/share/milkdrift/slotbook.md /workspace/docs/slotbook.md; fi' \
    > /usr/local/bin/initialize-slotbook && chmod 755 /usr/local/bin/initialize-slotbook
WORKDIR /workspace
