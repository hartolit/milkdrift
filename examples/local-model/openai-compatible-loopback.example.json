{
  "schema_version": 1,
  "identity": "local-model-loopback",
  "revision": 1,
  "protocol": {
    "type": "open_ai_compatible",
    "path": "v1/chat/completions"
  },
  "base_url": "http://127.0.0.1:8080",
  "model": "replace-with-exact-server-model-alias",
  "auth": {
    "type": "no_auth"
  },
  "limits": {
    "connect_timeout_ms": 10000,
    "request_timeout_ms": 120000,
    "idle_timeout_ms": 30000,
    "max_headers": 128,
    "max_header_bytes": 65536,
    "max_request_bytes": 4194304,
    "max_response_bytes": 4194304,
    "max_stream_line_bytes": 65536,
    "max_stream_event_bytes": 262144,
    "max_fragment_bytes": 4096
  },
  "redirect": "deny",
  "tls": "web_pki_roots",
  "proxy": "disabled",
  "features": [
    "streaming",
    "system_role"
  ],
  "max_concurrent": 1,
  "local_development": true,
  "allowed_hosts": [
    "127.0.0.1"
  ],
  "trust_zones": [
    "operator-configured-local-model"
  ],
  "provider_options": {}
}
