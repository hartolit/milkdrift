{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://milkdrift.dev/schema/external-evidence-report-v1.json",
  "title": "Milkdrift external interoperability evidence report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_unix_ms",
    "platform",
    "milkdrift",
    "configuration_digest",
    "qualifying",
    "fixture_mode",
    "process",
    "model",
    "validation",
    "redactions",
    "failure_reason"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at_unix_ms": { "type": "integer", "minimum": 0 },
    "platform": { "$ref": "#/$defs/platform" },
    "milkdrift": { "$ref": "#/$defs/milkdrift" },
    "configuration_digest": {
      "type": ["string", "null"],
      "pattern": "^b3_[0-9a-fA-F]{64}$"
    },
    "qualifying": { "type": "boolean" },
    "fixture_mode": { "type": "boolean" },
    "process": { "$ref": "#/$defs/scenario" },
    "model": { "$ref": "#/$defs/scenario" },
    "validation": {
      "type": "array",
      "items": { "$ref": "#/$defs/validation" }
    },
    "redactions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failure_reason": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "qualifying": { "const": true } },
        "required": ["qualifying"]
      },
      "then": {
        "properties": {
          "fixture_mode": { "const": false },
          "process": {
            "properties": { "qualifying": { "const": true } },
            "required": ["qualifying"]
          },
          "model": {
            "properties": { "qualifying": { "const": true } },
            "required": ["qualifying"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "fixture_mode": { "const": true } },
        "required": ["fixture_mode"]
      },
      "then": {
        "properties": {
          "qualifying": { "const": false },
          "process": {
            "properties": { "qualifying": { "const": false } },
            "required": ["qualifying"]
          },
          "model": {
            "properties": { "qualifying": { "const": false } },
            "required": ["qualifying"]
          }
        }
      }
    }
  ],
  "$defs": {
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "build_target"],
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "build_target": { "type": "string" }
      }
    },
    "milkdrift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starting_commit",
        "starting_tree",
        "workspace_version",
        "dirty_at_start"
      ],
      "properties": {
        "starting_commit": { "type": "string" },
        "starting_tree": { "type": "string" },
        "workspace_version": { "type": "string" },
        "dirty_at_start": { "type": "boolean" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualifying",
        "outcome",
        "profile",
        "commands",
        "runs",
        "revisions",
        "attempts",
        "proposals",
        "artifacts",
        "restart_boundaries",
        "facts",
        "failure_reason"
      ],
      "properties": {
        "qualifying": { "type": "boolean" },
        "outcome": {
          "type": "string",
          "enum": ["not_run", "succeeded", "failed"]
        },
        "profile": { "type": "object" },
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        },
        "runs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "revisions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "attempts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "proposals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" }
        },
        "restart_boundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/restart" }
        },
        "facts": { "type": "object" },
        "failure_reason": { "type": ["string", "null"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "digest", "size", "content_type", "role"],
      "properties": {
        "artifact_id": { "type": "string" },
        "digest": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "content_type": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "restart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "sequence_before",
        "sequence_after",
        "recovered_state",
        "duplicate_attempts"
      ],
      "properties": {
        "boundary": { "type": "string" },
        "sequence_before": { "type": "integer", "minimum": 0 },
        "sequence_after": { "type": "integer", "minimum": 0 },
        "recovered_state": { "type": "string" },
        "duplicate_attempts": { "type": "boolean" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_status"],
      "properties": {
        "command": { "type": "string" },
        "exit_status": { "type": "integer" }
      }
    }
  }
}
